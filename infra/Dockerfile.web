FROM --platform=linux/amd64 node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS dependencies
RUN npm install --global npm@10.9.8 && test "$(node --version)" = v22.23.2 && test "$(npm --version)" = 10.9.8
WORKDIR /workspace/apps/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY contracts /workspace/contracts
COPY apps/web .

FROM dependencies AS checks
RUN npm run typecheck && npm test && npm run build

FROM dependencies AS build
ARG VITE_AIST_SYNTHETIC=false
ENV VITE_AIST_SYNTHETIC=$VITE_AIST_SYNTHETIC
ARG VITE_AIST_QA=false
ENV VITE_AIST_QA=$VITE_AIST_QA
RUN npm run build

FROM --platform=linux/amd64 node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS runtime
RUN npm install --global npm@10.9.8 && test "$(node --version)" = v22.23.2 && test "$(npm --version)" = 10.9.8
WORKDIR /web
COPY --from=build /workspace/apps/web/dist ./dist
COPY apps/web/server.mjs ./server.mjs
USER node
CMD ["node", "server.mjs"]
