# Скопируйте в .env.local. Настоящий API-ключ хранится в .local/openai.key.
AIST_STACK_NAME=aist-local
AIST_WEB_PORT=30811
# Свободный префикс IPv4 /24, без последнего октета.
AIST_NETWORK_PREFIX=10.253.242
AIST_DB_PASSWORD=
# user_id из create-login; для нескольких пользователей перечислите через запятую.
AIST_CHAT_UI_OWNERS=
